# Node Environment (development, test, production)
NODE_ENV=development

# Server Port
PORT=4000

# Base URL for API
API_BASE_URL=http://localhost:4000

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://saathi_user:saathi_password@localhost:5432/saathi_db?schema=public

# Allowed CORS Origin for Web App
CORS_ORIGIN=http://localhost:3000

# JWT Access Secret (minimum 32 characters)
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_minimum_32_chars_for_saathi

# JWT Refresh Secret (minimum 32 characters)
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_minimum_32_chars_for_saathi

# Pino Logger Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
