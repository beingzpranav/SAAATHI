# ==============================================================================
# SAATHI Root Environment Configuration Template
# ==============================================================================
# This template documents environment variables across the monorepo.
# Copy apps/api/.env.example to apps/api/.env for the backend API.
# Copy apps/web/.env.example to apps/web/.env for the frontend Web application.

# Common Docker Compose Settings
POSTGRES_USER=saathi_user
POSTGRES_PASSWORD=saathi_password
POSTGRES_DB=saathi_db
POSTGRES_PORT=5432

# API Server Settings
API_PORT=4000
API_BASE_URL=http://localhost:4000
DATABASE_URL=postgresql://saathi_user:saathi_password@localhost:5432/saathi_db?schema=public

# Web Client Settings
WEB_PORT=3000
VITE_API_URL=http://localhost:4000/api/v1
